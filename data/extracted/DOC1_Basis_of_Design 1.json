      "heading": {
        "text": "1.1 Production Rate — Consistency Check",
        "level": 2
      },
      "level": 2,
      "paragraphs": [
        {
          "text": "The plant nameplate is 100 t/d product H₂SO₄. Surge capacity (for storage buffer and downstream demand) is 110 t/d (+10%). Equipment across the plant is rated at a minimum of 110% of nameplate to accommodate the surge, and pumps are rated to 130% of normal duty flow. Status reflects maximum operating vs. equipment rated.",
          "style": "Normal"
        }
      ],

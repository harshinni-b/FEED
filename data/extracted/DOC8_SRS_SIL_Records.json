      "heading": {
        "text": "2.1 Risk Graph Parameters",
        "level": 2
      },
      "level": 2,
      "paragraphs": [
        {
          "text": "The IEC 61511 Risk Graph uses four parameters: C = Consequence severity; F = Frequency/exposure of personnel; P = Probability of avoiding harm; W = Demand rate (without SIS). These parameters combine to yield a SIL target.",
          "style": "Normal"
        }
      ],

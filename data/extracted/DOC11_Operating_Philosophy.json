    {
      "heading": {
        "text": "3. SHIFT PHILOSOPHY AND OPERATOR RESPONSIBILITIES",
        "level": 1
      },
      "level": 1,
      "paragraphs": [],
      "tables": []
    },
    {
      "heading": {
        "text": "3.1 Staffing and Handover",
        "level": 2
      },
      "level": 2,
      "paragraphs": [],
      "tables": [
        {
          "index": 3,
          "rows": [
            [
              "Role",
              "Shift Structure",
              "Key Responsibilities",
              "Minimum Qualification"
            ],
            [
              "Control Room Operator (CRO)",
              "12-hour shifts (2 × 12 h; day and night)",
              "Monitor all DCS displays; acknowledge and respond to all alarms; execute start-up/shutdown sequences under Process Engineer direction",
              "Minimum 3 years process plant control room experience; H₂SO₄ or chemical plant preferred"
            ],
            [
              "Field Operator",
              "12-hour shifts",
              "Physical rounds every 2 hours; confirm valve positions; take manual readings; respond to CRO direction",
              "Trade-qualified; COSHH training; SCBA competent"
            ],
            [
              "Shift Supervisor",
              "12-hour shifts",
              "Shift handover; shift log completion; Permit-to-Work authority; emergency coordinator",
              "Minimum 5 years; first-line management trained"
            ],
            [
              "Process Engineer (on-call)",
              "Office hours + on-call",
              "Technical authority for non-routine operations; SIS bypass authorisation; LOPA review; MOC approval",
              "BEng Chemical Engineering; TÜV FS Engineer desirable"
            ]
          ]
        }
      ]
    },
    {
      "heading": {
        "text": "3.2 Shift Handover Requirements",
        "level": 2
      },
      "level": 2,
      "paragraphs": [
        {
          "text": "Shift handover shall be completed face-to-face in the control room with both incoming and outgoing CROs present. The outgoing operator shall verbally confirm the following, supported by the shift log:",
          "style": "Normal"
        },
        {
          "text": "1.  Current plant load (% and t/d) and trend direction",
          "style": "Normal"
        },
        {
          "text": "2.  All active alarms: acknowledged, priority, and action taken or pending",
          "style": "Normal"
        },
        {
          "text": "3.  Any abnormal operating conditions, equipment deficiencies, or deviations from SOP",
          "style": "Normal"
        },
        {
          "text": "4.  Active Permits to Work, including any ESD bypasses or SIS inhibits currently in place",
          "style": "Normal"
        },
        {
          "text": "5.  Status of all duty/standby equipment; any equipment out of service",
          "style": "Normal"
        },
        {
          "text": "6.  Sulfur storage tank level and estimated days of supply remaining",
          "style": "Normal"
        },
        {
          "text": "7.  Product storage tank level and dispatch schedule for next 24 hours",
          "style": "Normal"
        },
        {
          "text": "8.  Any outstanding laboratory results or quality deviations",
          "style": "Normal"
        }
      ],
      "tables": []
    },
    {
      "heading": {
        "text": "4. CONTROL MODE PHILOSOPHY",
        "level": 1
      },
      "level": 1,
      "paragraphs": [],
      "tables": []
    },
    {
      "heading": {
        "text": "4.1 Normal Operating Control Mode",
        "level": 2
      },
      "level": 2,
      "paragraphs": [
        {
          "text": "Under normal operating conditions all DCS PID loops shall operate in AUTOMATIC mode with remote setpoints from the Master Production Rate Governor. The following exceptions define when MANUAL mode is permissible:",
          "style": "Normal"
        }
      ],
      "tables": [
        {
          "index": 4,
          "rows": [
            [
              "Situation",
              "Loop",
              "Permitted Mode",
              "Authority Required",
              "Duration Limit",
              "Status Check"
            ],
            [
              "Analyser maintenance (AT-501/502)",
              "AIC-501/502",
              "MANUAL — operator trims dilution water FCV manually",
              "CRO with Shift Supervisor notification",
              "Duration of analyser maintenance + 30 min",
              "AIC must return to AUTO within 2 h"
            ],
            [
              "Blower surge event transient",
              "FIC-201",
              "MANUAL — temporarily fix air flow during transient",
              "CRO decision",
              "<15 minutes",
              "Return to AUTO when governor stable"
            ],
            [
              "WHB level extreme transient",
              "LIC-201",
              "MANUAL — BFW trim",
              "CRO decision",
              "<10 minutes; escalate to Process Engineer if longer",
              "Return to 3-element AUTO when level stable 40–60%"
            ],
            [
              "SIS bypass (any)",
              "SIS logic",
              "Hardwired bypass switch",
              "Process Engineer + Shift Supervisor",
              "Maximum 8 hours (auto timer)",
              "Log entry mandatory; DCS advisory active"
            ],
            [
              "Operation above 100% load",
              "Governor",
              "110% maximum; hard cap in DCS",
              "CRO with awareness that P1 temperature approaches alarm at surge",
              "Continuous at 110% is permissible; review monthly if sustained",
              "Monitor TT-401/402 closely at surge"
            ]
          ]
        }
      ]
    },
    {
      "heading": {
        "text": "4.2 Key Process Interaction Rules",
        "level": 2
      },
      "level": 2,
      "paragraphs": [
        {
          "text": "The following rules govern operator interaction with the tightly coupled process loops. Violation of these rules risks process upsets or SIS trips:",
          "style": "Normal"
        }
      ],
      "tables": [
        {
          "index": 5,
          "rows": [
            [
              "Rule",
              "Description",
              "Consequence of Violation"
            ],
            [
              "R-01: Air-before-Sulfur",
              "On any load increase: increase air flow first, confirm AT-201 response, then increase sulfur. Minimum 60-second lag.",
              "Sub-stoichiometric combustion → SO₂ spike → catalyst coking → conversion loss"
            ],
            [
              "R-02: Sulfur-before-Air (down)",
              "On any load decrease: reduce sulfur first, confirm SO₂ drop, then reduce air. Minimum 60-second lag.",
              "Over-stoichiometric air → excess O₂ → no harm, but wasted utility"
            ],
            [
              "R-03: Acid concentration first",
              "Do not adjust dilution water FCV-501/502 more than 5% output at a time. Wait 5 minutes for AT-501/502 response before further adjustment.",
              "Overshooting acid concentration → SO₃ mist or acid dilution → absorption loss and mist formation"
            ],
            [
              "R-04: Converter temperature priority",
              "If TT-402 (Pass 1 outlet) approaches 610°C, reduce plant load to 100% immediately — do not wait for alarm.",
              "At 621°C, SIS TSHH-401 trips — unplanned ESD shutdown"
            ],
            [
              "R-05: Product tank management",
              "Initiate tanker dispatch when product tank level reaches 70% (not 80% alarm). Do not allow product tank to reach 80% without a tanker confirmed on site.",
              "At 90% LSHH trips and SDV-E05 closes — production must halt"
            ]
          ]
        }
      ]
    },
    {
      "heading": {
        "text": "5. ENVIRONMENTAL COMPLIANCE OPERATING RULES",
        "level": 1
      },
      "level": 1,
      "paragraphs": [],
      "tables": [
        {
          "index": 6,
          "rows": [
            [
              "Environmental Parameter",
              "Normal Operating Target",
              "Limit in Consent",
              "Operator Action if Limit Approached",
              "Regulatory Reporting Trigger"
            ],
            [
              "Stack SO₂ (mg/Nm³, 30-min average)",
              "<300",
              "500",
              "Reduce load; check converter conversion; if >450 mg/Nm³, contact HSE",
              "If >500 mg/Nm³ for >30 min: report within 24 h per site environmental permit"
            ],
            [
              "Acid mist / SO₃ (mg/Nm³)",
              "<20",
              "35",
              "Inspect WESP; check IPAT/FAT acid concentration; check FT-501 dilution water flow",
              "If visible acid mist plume observed: immediate process review and log"
            ],
            [
              "Noise at plant boundary (dB(A))",
              "<63",
              "70",
              "Investigate equipment noise source; schedule maintenance",
              "If complaint received from neighbour: log and investigate within 24 h"
            ],
            [
              "H₂SO₄ in process effluent (pH)",
              "6–9",
              "6–9",
              "Check bund drainage isolation; neutralise before release",
              "Any acid spill to drain: report to Environment Agency immediately"
            ]
          ]
        }
      ]
    }
  ],

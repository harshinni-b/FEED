    {
      "heading": {
        "text": "3. CASCADE AND RATIO LOOP CONSISTENCY CHECK",
        "level": 1
      },
      "level": 1,
      "paragraphs": [
        {
          "text": "Cascade loops require that the primary (outer) loop responds significantly slower than the secondary (inner) loop. The ratio check confirms that the ratio of primary-to-secondary time constants is ≥5:1 for stable cascade operation.",
          "style": "Normal"
        }
      ],
      "tables": [
        {
          "index": 3,
          "rows": [
            [
              "Cascade Pair",
              "Primary Loop / PV",
              "Secondary Loop / PV",
              "Primary Time Const. (est.)",
              "Secondary Time Const. (est.)",
              "Ratio P:S"
            ],
            [
              "FIC-201 (Air/SO₂ ratio)",
              "AT-201 SO₂ analyser (slow — analyser lag)",
              "FT-201 Air flow (fast — DP transmitter)",
              "~2–5 min (analyser + process lag)",
              "~5–15 s (flow loop)",
              "~10:1"
            ],
            [
              "AIC-501 (IPAT acid conc.)",
              "AT-501 density (moderate response)",
              "FCV-501 water flow (fast — magnetic FM)",
              "~3–8 min (dilution mixing)",
              "~10–30 s (flow)",
              "~8:1"
            ],
            [
              "AIC-502 (FAT acid conc.)",
              "AT-502 density",
              "FCV-502 water flow",
              "~3–8 min",
              "~10–30 s",
              "~8:1"
            ],
            [
              "LIC-201 (3-element WHB)",
              "LT-201 drum level (slow — integrating process)",
              "BFW flow + steam flow (fast feed-forward)",
              "Integrating — no time const.",
              "~5–10 s",
              "N/A — feed-forward + FB"
            ],
            [
              "TIC-401 P1 bypass (split-range)",
              "TT-401 inlet temp",
